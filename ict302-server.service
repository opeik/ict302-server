#Put me in /lib/systemd/system/
[Unit]
Description=ICT 302 server
After=network.target ict302-mock-api.service

[Service]
Type=simple
User=student
Environment="RUST_LOG=warn,info,debug"
TTYPath=/dev/tty
WorkingDirectory=/home/student/server
ExecStart=/home/student/server/target/release/server
Restart=always

[Install]
WantedBy=multi-user.target
